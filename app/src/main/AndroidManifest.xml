<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <uses-feature
        android:name="android.hardware.faketouch"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:banner="@drawable/drbep_launcher_banner"
        android:icon="@drawable/drbep_launcher_icon"
        android:label="@string/app_name"
        android:logo="@drawable/drbep_launcher_banner"
        android:roundIcon="@drawable/drbep_launcher_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.DrbepTvPlayer">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:banner="@drawable/drbep_launcher_banner"
            android:icon="@drawable/drbep_launcher_icon"
            android:label="@string/app_name"
            android:logo="@drawable/drbep_launcher_banner"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".TvLauncherActivity"
            android:exported="true"
            android:banner="@drawable/drbep_launcher_banner"
            android:icon="@drawable/drbep_launcher_icon"
            android:label="@string/app_name"
            android:logo="@drawable/drbep_launcher_banner"
            android:roundIcon="@drawable/drbep_launcher_icon"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
